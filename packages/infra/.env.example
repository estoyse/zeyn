# Cloudflare auth — required for `pnpm deploy` and `pnpm deploy:dev`.
# Create an API token at https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Encrypts secret bindings stored in Alchemy state. Any strong random string.
ALCHEMY_PASSWORD=

# Remote Alchemy state store, so local and CI deploys share one source of truth.
# Optional: when unset, Alchemy falls back to the local `.alchemy/` file store.
ALCHEMY_STATE_TOKEN=
